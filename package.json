{
  "name": "topshelf",
  "version": "0.1.0",
  "private": true,
  "description": "TopShelf — the sentient bar.",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
